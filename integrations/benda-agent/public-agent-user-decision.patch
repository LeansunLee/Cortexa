+@router.get('/public/agent/sessions/{session_id}/result')
+async def public_agent_result(session_id: str, request: Request):
+    """Return a public turn's durable result without invoking any model or tool."""
+    _validate_api_key(request)
+    if not re.fullmatch(re.escape(PUBLIC_AGENT_ACCOUNT) + r'_[0-9a-f]{12}', session_id):
+        raise HTTPException(404, '会话不存在')
+    sess = session_manager.get_or_create(session_id, owner=PUBLIC_AGENT_ACCOUNT)
+    history = list(sess.history)
+    index = next((i for i in range(len(history)-1,-1,-1) if history[i].get('role') == 'user'), None)
+    if index is None:
+        raise HTTPException(404, '会话不存在')
+    user = history[index]
+    prior = history[index-1] if index else {}
+    last = history[-1]
+    status = last.get('status','running') if last.get('role') == 'assistant' else 'running'
+    pending = next((event for event in reversed(last.get('events') or []) if event.get('type') == 'ask_user'), None)
+    return {'session_id':session_id, 'status':status,
+            'answer':last.get('content','') if status != 'running' else '',
+            'answered_prompt':user.get('content',''),
+            'prior_question':next((event.get('question','') for event in reversed(prior.get('events') or [])
+                                   if event.get('type') == 'ask_user'), ''),
+            'pending_ask':{key:pending[key] for key in ('question','options','multi_select') if key in pending} if pending else None}
