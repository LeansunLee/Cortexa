# === LLM Provider Secrets ===
# Fill in the API key for your chosen provider in config.yaml.

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME

# DeepSeek
DEEPSEEK_API_KEY=sk-REPLACE_ME

# Moonshot (Kimi)
MOONSHOT_API_KEY=sk-REPLACE_ME

# Zhipu (GLM)
ZHIPU_API_KEY=sk-REPLACE_ME

# Anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Ollama runs locally, no key needed.
# Just start: ollama serve && ollama pull qwen2.5:7b

# === Optional ===
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=cortexa
